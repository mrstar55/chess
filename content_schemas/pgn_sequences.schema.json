{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chessbook.aistudio.com/schemas/pgn_sequences.schema.json",
  "title": "Chapter PGN Sequences",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["id", "description", "moves", "fens"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "description": { "type": "string" },
      "initial_fen": { "type": "string" },
      "moves": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "fens": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}
