{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chessbook.aistudio.com/schemas/exercises.schema.json",
  "title": "Chapter Exercises Manifest",
  "type": "object",
  "required": ["schemaVersion", "chapterId", "exercises"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "chapterId": { "type": "string", "minLength": 1 },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["exerciseId", "diagramId", "handlerType", "acceptedSolutionPgnRefs", "showLegalMovesHint"],
        "properties": {
          "exerciseId": { "type": "string", "minLength": 1 },
          "diagramId": { "type": "string", "minLength": 1 },
          "handlerType": {
            "type": "string",
            "enum": ["MATE_IN_ONE"]
          },
          "acceptedSolutionPgnRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "showLegalMovesHint": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
